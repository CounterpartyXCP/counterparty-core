[run]
concurrency = multiprocessing,thread
parallel = true
sigterm = true
omit =
    */lib/monitors/memory_profiler.py
    # Spawned test targets otherwise enter the child-process report even though
    # the pytest command measures only counterpartycore/lib. Keep test harnesses
    # out of production coverage; no runtime code or coverage gate is excluded.
    */counterpartycore/test/*
